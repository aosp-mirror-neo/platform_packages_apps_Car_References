<Controller id="drag_split_task_grip_controller">
    <ControllerName>com.android.systemui.car.wm.scalableui.view.GripBarViewController</ControllerName>
    <View>com.android.systemui.car.wm.scalableui.view.HorizontalGripBar</View>
    <EventId>_User_DragEvent_split</EventId>
    <DragDecreaseEventId>_User_DragEvent_split_decrease</DragDecreaseEventId>
    <DragIncreaseEventId>_User_DragEvent_split_increase"</DragIncreaseEventId>
    <Orientation>1</Orientation>
    <SnapThreadhold>5</SnapThreadhold>
    <BreakPoints>
        <BreakPoint point="0" eventId="_Drag_TaskSplitEvent_f0" />
        <BreakPoint point="1024" eventId="_Drag_TaskSplitEvent_f50" />
        <BreakPoint point="2048" eventId="_Drag_TaskSplitEvent_f100" />
    </BreakPoints>
</Controller>